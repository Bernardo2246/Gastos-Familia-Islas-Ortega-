# Cloudflare Workers Static Assets lee este archivo (mismo formato que
# Cloudflare Pages). Sin esto, index.html/sw.js se cacheaban con el
# mismo comportamiento por defecto que los archivos con hash, así que
# un deploy nuevo no se reflejaba hasta que la caché expiraba sola.
#
# index.html y sw.js SIEMPRE deben revalidarse: son los que apuntan a
# la versión vigente. sw.js es el más crítico de los dos — si el
# navegador no puede ver que sw.js cambió de bytes, nunca detecta que
# hay una versión nueva de la app y sigue sirviendo el index.html
# precacheado por el service worker viejo, sin importar qué tan fresco
# esté el index.html en el borde.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Los archivos bajo assets/ llevan hash de contenido en el nombre
# (index-DSumuK61.js, etc.): un cambio en el contenido siempre produce
# una URL nueva, así que cachearlos "para siempre" es seguro.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
